# Python and notebook by-products
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Generated search outputs: store only documented, versioned results intentionally.
# Bulk candidate dumps stay out; the curated dated records and the small, regenerable
# experiment logs they cite are versioned deliberately (all of results/ is ~15 KB).
results/*
!results/*.md
!results/logs/
results/logs/*
!results/logs/*.txt
!results/exp030/
!results/exp030/summary.json
!results/exp030/cases.jsonl.gz
scratch/
